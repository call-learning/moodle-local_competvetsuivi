{{!
  @template local_competvetsuivi/uevscompetency_details

  CompetVetSuivi page template for a single UE showing what competency contributes the most
  to the UE. Bar charts.

  Classes required for JS: all the boostrap classes for display

  Data attributes required for JS:

  Context variables required for this template:

  Example context (json):
  {
    "comp_fullname": "Competency fullname",
    "graph_title": "Graph Title",
    "comp_types": [{"comp_type_id": 1, "comp_type_name": "Knowledge"}],
    "breadcrumbs": [{"name": "Home", "link": "http://example.com"}],
    "compitems": [
      {
        "competency_fn": "Competency fullname",
        "competency_sn": "COMP1",
        "competency_link": "http://example.com",
        "graphdata": []
      }
    ]
  }

}}

<div class="container-fluid">
    {{> local_competvetsuivi/graph_header}}
    {{> local_competvetsuivi/competency_graphs}}
    {{< local_competvetsuivi/graph_footer}}
        {{$has_no_milestone}}{{/has_no_milestone}}
    {{/ local_competvetsuivi/graph_footer}}
</div>
