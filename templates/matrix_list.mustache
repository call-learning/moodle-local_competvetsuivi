{{!
    @template local_competvetsuivi/matrix_list

    This template will render all competvet suivi matrix

    Example context (json):
    {
      "addactionurl": "http://example.com/add",
      "matrix": [
        {
          "fullname": "Matrix 1",
          "shortname": "MAT1",
          "cohortsnames": "Cohort A",
          "lastmodified": 1609459200,
          "viewurl": "http://example.com/view",
          "editurl": "http://example.com/edit",
          "deleteurl": "http://example.com/delete",
          "assignurl": "http://example.com/assign"
        }
      ]
    }
}}

<div>
    <div class="action">
        <a href="{{{addactionurl}}}" class="btn btn-primary" role="button">{{#str}}matrix:add, local_competvetsuivi{{/str}}</a>
    </div>
    <div>
        <table class="generaltable fullwidth">
            <thead>
            <tr>
                <th scope="col">{{#str}}matrixname, local_competvetsuivi{{/str}}</th>
                <th scope="col">{{#str}}matrixshortname, local_competvetsuivi{{/str}}</th>
                <th scope="col">{{#str}}matrixassignedcohorts, local_competvetsuivi{{/str}}</th>
                <th scope="col">{{#str}}lastmodified{{/str}}</th>
                <th scope="col">{{#str}}action{{/str}}</th>
            </tr>
            </thead>
            <tbody>
            {{#matrix}}
                <tr>
                    <td>{{fullname}}</td>
                    <td>{{shortname}}</td>
                    <td>{{cohortsnames}}</td>
                    <td>{{#userdate}} {{lastmodified}}, {{#str}} strftimedate {{/str}} {{/userdate}}</td>
                    <td>
                        <a href="{{viewurl}}">{{# pix }} t/viewdetails, core, {{# str }} matrix:view, local_competvetsuivi {{/ str }} {{/ pix }}</a>
                        <a href="{{editurl}}">{{# pix }} t/edit, core, {{# str }} matrix:edit, local_competvetsuivi {{/ str }} {{/ pix }}</a>
                        <a href="{{deleteurl}}">{{# pix }} t/delete, core, {{# str }} matrix:delete, local_competvetsuivi {{/ str }} {{/ pix }}</a>
                        <a href="{{assignurl}}">{{# pix }} t/cohort, core, {{# str }} matrix:assigncohorts, local_competvetsuivi {{/ str }} {{/ pix }}</a>
                    </td>
                </tr>
            {{/matrix}}
            </tbody>
        </table>
    </div>
</div>
